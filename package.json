{
  "name": "apnascore",
  "version": "1.0.0",
  "description": "ApnaScore – Complete Cricket Scoring & Tournament Management Platform (Apne Gaon ka Apna Scorer)",
  "main": "backend/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "seed": "node backend/utils/seedSampleData.js",
    "test": "node --test backend/tests/scoringEngine.test.js backend/tests/rulesAndSync.test.js backend/tests/guestAuthAndMigrationUnit.test.js",
    "test:api": "node --test backend/tests/api.test.js",
    "test:e2e": "node --test backend/tests/guestAndMigration.test.js backend/tests/proAndPayments.test.js",
    "test:all": "node --test backend/tests/scoringEngine.test.js backend/tests/rulesAndSync.test.js backend/tests/guestAuthAndMigrationUnit.test.js backend/tests/api.test.js"
  },
  "keywords": [
    "cricket",
    "scoring",
    "tournament",
    "pwa",
    "offline-first",
    "apnascore"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "gsap": "^3.12.7",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
