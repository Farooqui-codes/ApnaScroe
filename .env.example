# ApnaScore Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/apnascore?retryWrites=true&w=majority

# Optional: Enable in-memory MongoDB fallback when MONGODB_URI is not set (dev/demo only)
ALLOW_MEMORY_DB_FALLBACK=false

# JWT Authentication
JWT_SECRET=replace_with_a_strong_64_char_random_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:5000

# Upload limits (bytes)
MAX_UPLOAD_SIZE=5242880
